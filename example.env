# Anthropic API key — required for the /demo route's variant generator.
# Without this, /api/demo falls back to a small set of hardcoded variants.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Stripe Payment Link for the founding-round CTA on the homepage.
# Without this, the "Claim a founding spot" buttons link to "#".
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Public origin used as metadataBase for OG / Twitter tags. Optional —
# defaults to https://eigentest.com if unset. Set this to your deploy URL
# (e.g. https://eigen.email) so OG image URLs resolve correctly.
NEXT_PUBLIC_SITE_URL=
